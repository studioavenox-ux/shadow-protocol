; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]
name="SHADOW PROTOCOL"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/textures/icon.png"
boot_splash/bg_color=Color(0.03137255, 0.03529412, 0.043137256, 1)

[autoload]
GameManager="*res://scripts/game_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/environment/defaults/default_clear_color=Color(0.03137255, 0.03529412, 0.043137256, 1)
environment/defaults/default_environment="res://assets/environment/default_env.tres"
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5

